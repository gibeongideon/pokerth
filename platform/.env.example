# Copy to .env for local runs. Never commit .env.
PLATFORM_ENV=local
PLATFORM_DEBUG=true
PLATFORM_PUBLIC_BASE_URL=http://localhost:3000
PLATFORM_DATABASE_URL=postgresql+asyncpg://platform:platform@localhost:55433/platform
PLATFORM_REDIS_URL=redis://localhost:56379/0

# Paystack test keys (sk_test_..., pk_test_...)
PLATFORM_PAYSTACK_SECRET_KEY=
PLATFORM_PAYSTACK_PUBLIC_KEY=
PLATFORM_PAYSTACK_TIMEOUT_SECONDS=15
