# Copy to .env for local runs. Never commit .env.
PLATFORM_ENV=local
PLATFORM_DEBUG=true
PLATFORM_PUBLIC_BASE_URL=http://localhost:3000
PLATFORM_DATABASE_URL=postgresql+asyncpg://platform:platform@localhost:55433/platform
PLATFORM_REDIS_URL=redis://localhost:56379/0

# Paystack test keys (sk_test_..., pk_test_...)
PLATFORM_PAYSTACK_SECRET_KEY=
PLATFORM_PAYSTACK_PUBLIC_KEY=
PLATFORM_PAYSTACK_TIMEOUT_SECONDS=15

# Comma-free JSON lists
PLATFORM_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Google OAuth client IDs (web, Android, iOS) - empty disables Google sign-in
PLATFORM_GOOGLE_CLIENT_IDS=[]
# Required outside local: 32+ random chars, e.g. `openssl rand -base64 48`
PLATFORM_JWT_SECRET=
# Paystack webhook source IPs (set in staging/prod; leave empty locally)
# PLATFORM_PAYSTACK_WEBHOOK_IPS=["52.31.139.75","52.49.173.169","52.214.14.220"]

# SMTP (Mailpit locally on 51025; real provider in prod)
PLATFORM_SMTP_HOST=localhost
PLATFORM_SMTP_PORT=51025
PLATFORM_SMTP_FROM=Poker <no-reply@localhost>
